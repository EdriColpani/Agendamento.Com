# Copie para .env e preencha valores reais.
# NÃO commitar o arquivo .env.

# --- Server ---
SERVER_URL=http://localhost:8080
AUTHENTICATION_API_KEY=CHANGE_ME_gerar_com_openssl_rand_hex_32

# --- Database (PostgreSQL do stack Evolution) ---
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:CHANGE_ME_DB_PASSWORD@evolution-postgres:5432/evolution_db?schema=evolution_api
POSTGRES_DATABASE=evolution_db
POSTGRES_USERNAME=evolution
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# --- Redis ---
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://evolution-redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution

# --- Integrações desnecessárias (escopo PlanoAgenda = só notificação) ---
WEBHOOK_GLOBAL_ENABLED=false
RABBITMQ_ENABLED=false
SQS_ENABLED=false
CHATWOOT_ENABLED=false
TYPEBOT_ENABLED=false
DIFY_ENABLED=false

# --- Observação ---
# A Edge Function no Supabase NÃO alcança localhost.
# Em teste/prod, exponha a API via HTTPS (reverse proxy) e use essa URL em EVOLUTION_API_URL.
